{
  "name": "Demo_RPG",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/Shared"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Animations": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Models": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "VFX": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Sounds": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/Server"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/Client"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/CharacterScripts/Health.server.luau"
        }
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
