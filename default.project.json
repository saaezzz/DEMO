{
  "name": "Demo_RPG",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/Shared"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Animations": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Models": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "VFX": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Sounds": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/Server"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/Client"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/CharacterScripts/Health.server.luau"
        }
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 768
      },
      "MapDetails": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.2,
          0.2,
          0.22
        ],
        "OutdoorAmbient": [
          0.5,
          0.5,
          0.52
        ],
        "Brightness": 2.5,
        "ClockTime": 9,
        "GeographicLatitude": 35.7,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "ShadowSoftness": 0.25,
        "Outlines": false,
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
